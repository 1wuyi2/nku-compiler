const int BASE = 3;
const int LIMIT = 8;

int calc(int n)
{
    int values[8];
    int i;
    int result;

    i = 0;
    result = 0;

    while (i < n)
    {
        if ((i + 1) % 2 == 0)
        {
            values[i] = (i + 1) * (i + 1);
        }
        else
        {
            values[i] = -(i + 1);
        }

        result = result + values[i];

        i = i + 1;
    }

    return result;
}

int main()
{
    int n;
    int result;
    int quotient;
    int remainder;

    n = getint();

    if (n < 1)
    {
        n = 1;
    }
    else
    {
        if (n > LIMIT)
        {
            n = LIMIT;
        }
    }

    result = calc(n);

    quotient = n / 2;
    remainder = n % 2;

    result = result + quotient + remainder + BASE;

    putint(result);
    putch(10);

    return 0;
}